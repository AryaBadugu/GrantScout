
# IBM watsonx.ai credentials (mandatory)
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Granite model IDs (change only if your Lite account has different models)
GRANITE_INSTRUCT_MODEL=ibm/granite-4-h-small
GRANITE_EMBEDDING_MODEL=ibm/granite-embedding-278m-multilingual

# IBM Cloud Object Storage (optional – local fallback used if absent)
COS_API_KEY=
COS_INSTANCE_CRN=
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET=grantscout-docs

# Tuning (optional – defaults shown)
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=8
LLM_MAX_NEW_TOKENS=1500
LLM_TEMPERATURE=0.1
EXTRACTION_MAX_RETRIES=3
